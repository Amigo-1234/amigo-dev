# All optional. The site builds and runs without any of these.

# Canonical origin used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://amigo-dev.vercel.app

# EmailJS (browser-side, public by design). Restrict the allowed origin in the
# EmailJS dashboard. Without these, the contact form falls back to email.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
